# Database
# Runtime connection (CRUD only). Required.
DATABASE_URL=postgresql://daubert:daubert@localhost:5455/daubert

# Admin connection (owner role) — only used by ./migrations.sh in production.
# In dev, leave blank or unset; migrations.sh --dev uses DATABASE_URL.
# DATABASE_ADMIN_URL=postgresql://owner:password@host/db?sslmode=require

# Blockchain API keys
ETHERSCAN_API_KEY=your-etherscan-api-key
TRONSCAN_API_KEY=your-tronscan-api-key

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Firebase (required for auth)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Data Room file storage.
# Production: required — GCS bucket that holds uploaded/imported case files.
GCS_DATA_ROOM_BUCKET=your-data-room-bucket
# Non-production: optional override for the local-disk storage directory
# (defaults to <os-tmpdir>/daubert-data-room). Ignored in production.
# DATA_ROOM_LOCAL_DIR=/tmp/daubert-data-room
# Drive import uses a short-lived client-side drive.file token (no backend
# OAuth client/secret/redirect). The frontend OAuth client ID + picker key
# live in frontend/.env (NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID, NEXT_PUBLIC_DRIVE_PICKER_KEY).

# Frontend origin — used to build links in transactional email. Required.
FRONTEND_URL=http://localhost:3001

# OAuth authorization server
# Public base URL of this backend — used as the OAuth issuer identifier. Required.
OAUTH_ISSUER_URL=http://localhost:8081
# Signs OAuth state parameters to prevent CSRF. Must be ≥32 chars. Required.
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=your-64-char-hex-secret-here
# Optional TTLs — defaults shown; override per environment if needed.
# OAUTH_ACCESS_TOKEN_TTL_S=3600
# OAUTH_REFRESH_TOKEN_TTL_DAYS=30
# OAUTH_CODE_TTL_S=60

# External trace API
# Shared secret the marketing site server sends in X-Daubert-Website-Key.
# Required: the backend refuses to start if this is missing or shorter than 16 chars.
# Dev: use the literal string "dev-key-dev-key-dev" (>=16 chars).
# Prod: generate a fresh 32-byte secret per environment.
DAUBERT_WEBSITE_API_KEY=

# Resend (transactional email — OTP codes, future invite emails)
# Setup runbook: docs/plans/2026-06-02-resend-setup.md.
# Per-env API key, restricted to the auth.dauberts.ai sending domain.
RESEND_API_KEY=re_your_resend_api_key
# Display-name + address shape — what recipients see in their inbox From field.
EMAIL_FROM_ADDRESS=Daubert AI <noreply@auth.dauberts.ai>
# Replies to OTP/transactional mail land here.
EMAIL_REPLY_TO=hello@dauberts.ai
